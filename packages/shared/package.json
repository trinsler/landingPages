{
  "name": "@monorepo/shared",
  "version": "1.0.2",
  "description": "Shared utilities, types and constants for all apps",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./styles/*": "./src/styles/*"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "src"
  ],
  "peerDependencies": {
    "vue": "^3.5.42",
    "stripe": "^18.5.0",
    "@supabase/supabase-js": "^2.112.4"
  }
}
