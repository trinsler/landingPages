{
  "name": "@imagio/learning-platform",
  "version": "2.0.1",
  "description": "Enterprise-grade learning platform with advanced keyword analysis and speech recognition",
  "type": "module",
  "private": true,
  "scripts": {
    "prebuild": "nuxt prepare",
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && npm run db:generate",
    "start": "node .output/server/index.mjs",
    "clean": "rm -rf .nuxt .output dist coverage",
    "typecheck": "nuxt typecheck",
    "lint": "eslint . --ext .ts,.vue,.js",
    "lint:fix": "eslint . --ext .ts,.vue,.js --fix",
    "format": "prettier --write \"**/*.{ts,vue,js,json,md}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:coverage": "vitest --coverage",
    "test:integration": "vitest run tests/integration",
    "test:unit": "vitest run tests/unit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "security:audit": "npm audit --audit-level moderate",
    "security:scan": "snyk test",
    "security:fix": "npm audit fix",
    "docker:build": "docker build -t imagio-platform:latest .",
    "docker:run": "docker run -p 3000:3000 imagio-platform:latest",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:clean": "docker-compose down -v && docker system prune -f",
    "performance:test": "autocannon http://localhost:3000 --duration 30",
    "performance:profile": "clinic doctor -- node .output/server/index.mjs",
    "docs:generate": "typedoc --out docs --entryPointStrategy expand ./server ./types",
    "prepare": "husky install",
    "precommit": "lint-staged",
    "validate": "npm run lint && npm run typecheck && npm run test:unit",
    "ci": "npm run validate && npm run test:coverage && npm run security:audit"
  },
  "dependencies": {
    "@nuxt/devtools": "^3.3.1",
    "@nuxt/image": "^1.8.1",
    "@pinia/nuxt": "^0.5.5",
    "@prisma/client": "^5.22.0",
    "@types/jsonwebtoken": "^9.0.7",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "nuxt": "^3.20.1",
    "pinia": "^2.2.6",
    "prisma": "^5.22.0",
    "reflect-metadata": "^0.2.2",
    "vue": "^3.5.25",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "^0.8.0",
    "@nuxt/test-utils": "^3.15.2",
    "@playwright/test": "^1.49.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.6",
    "autocannon": "^7.15.0",
    "clinic": "^13.0.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-vue": "^9.31.0",
    "happy-dom": "^20.0.10",
    "husky": "^9.1.7",
    "jsdom": "^27.2.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2",
    "snyk": "^1.1293.1",
    "tsx": "^4.19.2",
    "typedoc": "^0.27.4",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/imagio/learning-platform.git"
  },
  "keywords": [
    "nuxt3",
    "vue3",
    "typescript",
    "enterprise",
    "learning-platform",
    "education",
    "keyword-analysis",
    "speech-recognition",
    "prisma",
    "domain-driven-design",
    "cqrs",
    "clean-architecture"
  ],
  "author": {
    "name": "IMAGIO Platform Team",
    "email": "dev@imagio.com",
    "url": "https://imagio.com"
  },
  "license": "PROPRIETARY",
  "volta": {
    "node": "20.11.0",
    "npm": "10.2.4"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  }
}
