# SCALE-READY DOCKERFILE
# Optimized for PostgreSQL + Redis production deployment

# ==========================================
# STAGE 1: Dependencies
# ==========================================
FROM node:20-alpine AS deps

WORKDIR /app

# Install system dependencies
RUN apk add --no-cache \
    libc6-compat \
    ca-certificates \
    curl \
    postgresql-client

# Copy package files
COPY package.json package-lock.json* ./
COPY prisma/schema.prisma ./prisma/schema.prisma

# Install dependencies
RUN npm ci --only=production --no-audit --prefer-offline && \
    npm cache clean --force

# ==========================================
# STAGE 2: Builder
# ==========================================
FROM node:20-alpine AS builder

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache \
    libc6-compat \
    postgresql-client \
    curl

# Copy node_modules from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy all source files
COPY . .

# Generate Prisma Client
RUN npx prisma generate

# Build the application
RUN npm run build

# ==========================================
# STAGE 3: Production Runner
# ==========================================
FROM node:20-alpine AS runner

WORKDIR /app

# Install minimal runtime dependencies + health check tools
RUN apk add --no-cache \
    ca-certificates \
    tini \
    curl \
    postgresql-client

# Create dedicated user for security
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nuxtjs --ingroup nodejs

# Copy build output
COPY --from=builder --chown=nuxtjs:nodejs /app/.output ./.output
COPY --from=builder --chown=nuxtjs:nodejs /app/prisma ./prisma

# Copy health check script
COPY --chown=nuxtjs:nodejs scripts/health-check.sh /usr/local/bin/health-check.sh
RUN chmod +x /usr/local/bin/health-check.sh

# Switch to non-root user
USER nuxtjs

# Enhanced health check for scale environment
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD /usr/local/bin/health-check.sh

EXPOSE 3000

# Use tini as PID 1 for proper signal handling
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", ".output/server/index.mjs"]