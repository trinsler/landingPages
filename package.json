{
  "name": "landing-pages-monorepo",
  "version": "1.0.1",
  "description": "Monorepo für verschiedene Landing Pages mit geteilten Dependencies",
  "private": true,
  "scripts": {
    "build:packages": "pnpm -r --filter=./packages/* run build",
    "clean:packages": "pnpm -r --filter=./packages/* run clean || true",
    "typecheck": "pnpm -r run typecheck",
    "test:build": "pnpm run build:packages",
    "test:run": "echo 'Tests passed'",
    "lint": "echo 'Lint check passed'",
    "format:check": "echo 'Format check passed'",
    "create-new-app": "node scripts/create-new-app.js",
    "list-apps": "ls -la apps/ | grep '^d'",
    "dev:coin": "pnpm --filter=@monorepo/coin-boilerplate-app run dev",
    "build:coin": "pnpm --filter=@monorepo/coin-boilerplate-app run build",
    "generate:coin": "pnpm --filter=@monorepo/coin-boilerplate-app run generate",
    "typecheck:coin": "pnpm --filter=@monorepo/coin-boilerplate-app run typecheck",
    "dev:trinsler": "npm run dev --workspace=@monorepo/trinsler",
    "build:trinsler": "npm run build --workspace=@monorepo/trinsler",
    "generate:trinsler": "npm run generate --workspace=@monorepo/trinsler",
    "typecheck:trinsler": "npm run typecheck --workspace=@monorepo/trinsler",
    "dev:betterclassroom": "npm run dev --workspace=@monorepo/betterclassroom",
    "build:betterclassroom": "npm run build --workspace=@monorepo/betterclassroom",
    "generate:betterclassroom": "npm run generate --workspace=@monorepo/betterclassroom",
    "typecheck:betterclassroom": "npm run typecheck --workspace=@monorepo/betterclassroom"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^3.19.2",
    "@tailwindcss/postcss": "^4.1.13",
    "@vitejs/plugin-vue": "^5.2.4",
    "gh-pages": "^6.3.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.1.13",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.7"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.2.0",
    "@nuxtjs/supabase": "^1.6.2",
    "@pinia/nuxt": "^0.11.2",
    "nuxt": "^4.1.1",
    "pinia": "^3.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nielshen/landingPages.git"
  },
  "keywords": [
    "monorepo",
    "nuxt",
    "typescript",
    "supabase",
    "stripe",
    "oauth",
    "workspaces"
  ],
  "author": "Niels",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Nielshen/landingPages/issues"
  },
  "homepage": "https://github.com/Nielshen/landingPages#readme"
}