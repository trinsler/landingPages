{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":separateMajorReleases",
    ":combinePatchMinorReleases",
    "group:monorepos",
    "group:recommended",
    "workarounds:all"
  ],
  "description": "Renovate config for landing-pages-monorepo with supply chain security",
  "platform": "github",
  "username": "renovate[bot]",
  "gitAuthor": "Renovate Bot <bot@renovateapp.com>",
  "repositories": ["Nielshen/landingPages"],
  "onboarding": false,
  "requireConfig": "optional",
  "minimumReleaseAge": "5 days",
  "internalChecksFilter": "strict",
  "branchPrefix": "renovate/",
  "branchConcurrentLimit": 5,
  "prConcurrentLimit": 10,
  "automerge": false,
  "platformAutomerge": false,
  "rebaseWhen": "conflicted",
  "rangeStrategy": "bump",
  "bumpVersion": "patch",
  "commitMessageTopic": "{{depName}}",
  "commitMessageAction": "update",
  "commitMessageExtra": "to {{newVersion}}",
  "commitMessagePrefix": "chore(deps): ",
  "labels": ["dependencies", "renovate"],
  "addLabels": ["auto-dependency-update"],
  "assignees": [],
  "reviewers": [],
  "timezone": "Europe/Berlin",
  "schedule": ["before 6am on monday"],
  "prTitle": "{{#if isPinDigest}}{{commitMessageAction}} {{depName}} commit hash{{else}}{{commitMessagePrefix}} {{commitMessageAction}} {{depName}}{{/if}}",
  "prBodyTemplate": "This PR contains the following updates:\n\n| Package | Change | Age | Adoption | Passing | Confidence |\n|---|---|---|---|---|---|\n{{#each upgrades as |upgrade|}}\n|{{upgrade.depName}}|{{upgrade.currentVersion}} -> {{upgrade.newVersion}}|[![age](https://developer.mend.io/api/mc/badges/age/{{upgrade.datasource}}/{{upgrade.depName}}/{{upgrade.newVersion}}?slim=true)](https://docs.renovatebot.com/merge-confidence/)|[![adoption](https://developer.mend.io/api/mc/badges/adoption/{{upgrade.datasource}}/{{upgrade.depName}}/{{upgrade.newVersion}}?slim=true)](https://docs.renovatebot.com/merge-confidence/)|[![passing](https://developer.mend.io/api/mc/badges/compatibility/{{upgrade.datasource}}/{{upgrade.depName}}/{{upgrade.currentVersion}}/{{upgrade.newVersion}}?slim=true)](https://docs.renovatebot.com/merge-confidence/)|[![confidence](https://developer.mend.io/api/mc/badges/confidence/{{upgrade.datasource}}/{{upgrade.depName}}/{{upgrade.currentVersion}}/{{upgrade.newVersion}}?slim=true)](https://docs.renovatebot.com/merge-confidence/)|\n{{/each}}\n\n---\n\n🤖 This PR has been generated by [Renovate Bot](https://github.com/renovatebot/renovate).\n\n### 🔒 Supply Chain Security\n- ✅ All packages are at least **5 days old** (supply chain protection)\n- ✅ Security vulnerabilities are handled with priority\n- ✅ All tests must pass before merge\n\n### 📋 Review Checklist\n- [ ] Verify changelog for breaking changes\n- [ ] Check test coverage impact\n- [ ] Review security implications\n- [ ] Validate monorepo compatibility",
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null,
    "labels": ["security", "vulnerability"],
    "assignees": [],
    "reviewers": [],
    "prPriority": 10,
    "commitMessagePrefix": "fix(security): ",
    "branchTopic": "security-{{{datasource}}}-{{{depName}}}"
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Monorepo packages - group together",
      "groupName": "monorepo packages",
      "schedule": ["before 6am on monday"],
      "matchSourceUrls": [
        "https://github.com/nuxt/{/,}**",
        "https://github.com/vitejs/{/,}**",
        "https://github.com/vitest-dev/{/,}**",
        "https://github.com/tailwindlabs/{/,}**"
      ]
    },
    {
      "description": "Security updates - immediate",
      "matchCurrentAge": "< 5 days",
      "matchUpdateTypes": ["patch"],
      "enabled": false,
      "matchPackageNames": ["*"]
    },
    {
      "description": "Critical security - override age restriction",
      "matchDepTypes": ["devDependencies", "dependencies"],
      "vulnerabilityAlerts": {
        "minimumReleaseAge": null,
        "enabled": true
      }
    },
    {
      "description": "Major updates - separate PRs with extra care",
      "matchUpdateTypes": ["major"],
      "minimumReleaseAge": "7 days",
      "prPriority": -10,
      "labels": ["dependencies", "major-update"],
      "addLabels": ["needs-manual-review"]
    },
    {
      "description": "Minor and patch - can be grouped",
      "matchUpdateTypes": ["minor", "patch"],
      "minimumReleaseAge": "5 days",
      "groupName": "non-major dependencies",
      "prPriority": 0
    },
    {
      "description": "ESLint ecosystem",
      "matchPackageNames": [
        "eslint",
        "@typescript-eslint/eslint-plugin",
        "@typescript-eslint/parser",
        "eslint-plugin-vue",
        "@nuxt/eslint-config"
      ],
      "groupName": "ESLint ecosystem",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Testing ecosystem",
      "matchPackageNames": [
        "vitest",
        "@vitest/coverage-v8",
        "@vitest/ui",
        "@vue/test-utils",
        "@nuxt/test-utils"
      ],
      "groupName": "Testing ecosystem",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Nuxt ecosystem",
      "matchPackageNames": [
        "nuxt",
        "@nuxtjs/tailwindcss",
        "@nuxtjs/supabase",
        "@pinia/nuxt"
      ],
      "groupName": "Nuxt ecosystem",
      "minimumReleaseAge": "7 days",
      "prPriority": 5
    },
    {
      "description": "TypeScript ecosystem",
      "matchPackageNames": ["typescript", "vue-tsc", "@types/node"],
      "groupName": "TypeScript ecosystem",
      "minimumReleaseAge": "5 days"
    },
    {
      "description": "Pin GitHub Actions to digest",
      "matchManagers": ["github-actions"],
      "pinDigests": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Disable updates for local packages",
      "matchPackageNames": [
        "@monorepo/ui",
        "@monorepo/shared",
        "@monorepo/trinsler",
        "@monorepo/betterclassroom",
        "@monorepo/coin-boilerplate-app"
      ],
      "enabled": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am"],
    "commitMessageAction": "refresh",
    "commitMessageTopic": "lock file",
    "prTitle": "chore(deps): refresh lock file",
    "branchTopic": "lock-file-maintenance"
  },
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "🤖 Dependency Dashboard",
  "dependencyDashboardHeader": "This issue lists Renovate updates and detected dependencies. Read the [Dependency Dashboard](https://docs.renovatebot.com/key-concepts/dashboard/) docs to learn more.\n\n## 🔒 Supply Chain Security\n- **5-day minimum age** for all non-security updates\n- **Immediate updates** for security vulnerabilities\n- **Grouped updates** for related packages\n- **Manual review** required for all major updates",
  "includePaths": [
    "package.json",
    "apps/*/package.json",
    "packages/*/package.json"
  ],
  "ignoreDeps": [],
  "ignorePaths": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.output/**",
    "**/.nuxt/**"
  ]
}
